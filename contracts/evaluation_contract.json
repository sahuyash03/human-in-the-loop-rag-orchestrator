{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RAGEvaluationAndRoutingPayload",
    "type": "object",
    "properties": {
        "query_id": {
            "type": "string"
        },
        "grounding_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Token-level citation overlap score between context and response"
        },
        "relevance_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Cross-encoder semantic similarity between prompt and response"
        },
        "routing_decision": {
            "type": "string",
            "enum": [
                "AUTO_DELIVERY",
                "ESCALATE_TO_SME"
            ]
        },
        "escalation_reason": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "query_id",
        "grounding_score",
        "relevance_score",
        "routing_decision"
    ]
}